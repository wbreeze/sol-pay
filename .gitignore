# See https://help.github.com/articles/ignoring-files/ for more about ignoring
# files. Both Rust crates carry their own .gitignore for build output.

# misc
.DS_Store

# Per-person Claude Code settings (tool permissions and the like). Only the
# .local file: `.claude/` as a whole stays trackable on purpose, so a shared
# settings.json or a project skill can be committed later without first having
# to notice that a blanket ignore is hiding it.
.claude/settings.local.json

# The context brief and its state file, rewritten by a scheduled routine on
# each run. They describe the working tree rather than belong to it, and
# committing them would add a commit's worth of churn every time it fires.
.claude/brief-state.json
.claude/context-brief.md
