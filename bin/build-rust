#!/usr/bin/env bash
#
# Build the on-chain program and the WASM client.
#
#   bin/build-rust             program + client
#   bin/build-rust --program   just the Anchor program
#   bin/build-rust --client    just the WASM client
#
# The client bundle lands in wasm-client/pkg (gitignored).

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

want_program=1
want_client=1
case "${1:-}" in
  --program) want_client=0 ;;
  --client)  want_program=0 ;;
  "")        ;;
  *) echo "usage: $(basename "$0") [--program|--client]" >&2; exit 2 ;;
esac

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "error: $1 not found. $2" >&2
    exit 1
  }
}

if [ "$want_program" = 1 ]; then
  need anchor "Install with: cargo install --git https://github.com/solana-foundation/anchor avm && avm install latest"
  echo "==> anchor build"
  ( cd "$ROOT/pay-on-chain" && anchor build )
fi

if [ "$want_client" = 1 ]; then
  need wasm-pack "Install with: brew install wasm-pack"
  # Both of these run *inside* wasm-client, and the directory is the point:
  # rust-toolchain.toml is directory-scoped, so asking rustup from the
  # repository root answers for whatever toolchain happens to be default
  # rather than the pinned one. Get that wrong and the check passes while the
  # toolchain that does the building has no wasm target. wasm-pack installs it
  # a moment later and hides the difference -- a repair worth not depending
  # on, and the same mistake that failed the drift workflow on 2026-09-01.
  (
    cd "$ROOT/wasm-client"
    rustup target list --installed | grep -qx wasm32-unknown-unknown || {
      echo "==> adding wasm32-unknown-unknown target"
      rustup target add wasm32-unknown-unknown
    }
  )
  # --locked: build the versions in Cargo.lock or fail, never re-resolve.
  # --features wasm: the feature is opt-in so that a site's Rust server can
  # depend on the crate without wasm-bindgen. The browser bundle is the thing
  # that wants it, so the browser bundle asks.
  echo "==> wasm-pack build"
  ( cd "$ROOT/wasm-client" && wasm-pack build --target web -- --locked --features wasm )
fi

echo "done."
