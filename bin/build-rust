#!/usr/bin/env bash
#
# Build the on-chain program and the WASM client.
#
#   bin/build-rust             program + client
#   bin/build-rust --program   just the Anchor program
#   bin/build-rust --client    just the WASM client
#
# The client bundle lands in wasm-client/pkg (gitignored).

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

want_program=1
want_client=1
case "${1:-}" in
  --program) want_client=0 ;;
  --client)  want_program=0 ;;
  "")        ;;
  *) echo "usage: $(basename "$0") [--program|--client]" >&2; exit 2 ;;
esac

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "error: $1 not found. $2" >&2
    exit 1
  }
}

if [ "$want_program" = 1 ]; then
  need anchor "Install with: cargo install --git https://github.com/solana-foundation/anchor avm && avm install latest"
  echo "==> anchor build"
  ( cd "$ROOT/pay-on-chain" && anchor build )
fi

if [ "$want_client" = 1 ]; then
  need wasm-pack "Install with: brew install wasm-pack"
  # wasm-pack usually adds this itself, but failing here is clearer than
  # failing halfway through a build.
  rustup target list --installed | grep -qx wasm32-unknown-unknown || {
    echo "==> adding wasm32-unknown-unknown target"
    rustup target add wasm32-unknown-unknown
  }
  # --locked: build the versions in Cargo.lock or fail, never re-resolve.
  echo "==> wasm-pack build"
  ( cd "$ROOT/wasm-client" && wasm-pack build --target web -- --locked )
fi

echo "done."
