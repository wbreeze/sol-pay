#!/usr/bin/env bash
#
# Remove build output. Everything this deletes is regenerated by
# bin/build-rust, bin/test-node or bin/test-php, and is listed in a
# .gitignore file.
#
#   bin/clean             program + client + the conformance vectors
#   bin/clean --program   just the Anchor program's output
#   bin/clean --client    just the WASM client's output
#
# The conformance material belongs to neither flag -- both bin/test-node and
# bin/test-php use it -- so it goes only with a full run.
#
# Nothing here touches source, and nothing touches test-ledger: the local
# validator's chain state is not build output, and you may be mid-way through
# using it.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

want_program=1
want_client=1
case "${1:-}" in
  --program) want_client=0 ;;
  --client)  want_program=0 ;;
  "")        ;;
  *) echo "usage: $(basename "$0") [--program|--client]" >&2; exit 2 ;;
esac

# This script runs rm -rf against paths built from $ROOT. Confirm $ROOT is the
# repository before trusting it, so a move or a bad symlink fails here rather
# than somewhere expensive.
for marker in pay-on-chain/Anchor.toml wasm-client/Cargo.toml php-client/composer.json; do
  [ -f "$ROOT/$marker" ] || {
    echo "error: $ROOT/$marker is missing; this does not look like sol-pay" >&2
    exit 1
  }
done

drop() {
  local path="$ROOT/$1"
  if [ -e "$path" ]; then
    echo "==> $1"
    rm -rf "$path"
  fi
}

if [ "$want_program" = 1 ]; then
  drop pay-on-chain/target
  drop pay-on-chain/.anchor
fi

if [ "$want_client" = 1 ]; then
  drop wasm-client/target
  drop wasm-client/pkg
fi

# The vector generator's build directory and the vectors themselves, both
# gitignored and both regenerated on demand by bin/test-node and bin/test-php.
# The target/ here is a full Rust build of the published crate plus its
# dependencies and is the largest thing this script removes by some margin.
#
# php-client/vendor/ is deliberately not in this list. It is an installed
# dependency tree rather than build output, restoring it needs the network,
# and nothing in this repository builds it -- `composer install` does, when a
# person asks for it.
if [ "$want_program" = 1 ] && [ "$want_client" = 1 ]; then
  drop php-client/vectors-gen/target
  drop php-client/vectors-gen/vectors.json
fi

echo "done."
