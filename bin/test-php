#!/usr/bin/env bash
#
# Check the PHP port against vectors generated by the published crate.
#
#   bin/test-php
#
# This is SPEC.md §8.1's drift control, and it is a different question from
# `composer test`. The PHPUnit suite hardcodes its expected values as literals
# -- deliberately, so a local regression names the assertion that broke -- and
# frozen literals cannot notice the crate moving underneath them. These vectors
# can, because they are regenerated from the *published* crate on every run.
#
# Different again from bin/test-node, which loads the same wasm binary the
# browser loads and therefore guards a loading contract rather than an
# agreement between two implementations. Only this one is drift control.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VECTORS="$ROOT/php-client/vectors-gen/vectors.json"

command -v php >/dev/null 2>&1 || { echo "error: php not found." >&2; exit 1; }

if [ ! -f "$ROOT/php-client/vendor/autoload.php" ]; then
  command -v composer >/dev/null 2>&1 || {
    echo "error: composer not found, and php-client/vendor is missing." >&2
    echo "Install with: brew install composer -- and see php-client/README.md" >&2
    echo "for what that does to a version-pinned php on PATH." >&2
    exit 1
  }
  # Full install here, dev dependencies included, because a person running
  # this on a dev machine wants `composer test` to work straight after. CI
  # installs with --no-dev instead: the library needs no runtime dependencies,
  # and PHPUnit's tree cannot resolve on the PHP floor composer.json declares.
  echo "==> composer install"
  ( cd "$ROOT/php-client" && composer install --no-interaction )
fi

# Generated, gitignored, and derived from the published crate rather than from
# this tree -- which is the point: the vectors are an outside opinion about
# what the right answers are.
#
# Regenerated every run, with no "skip if the file already exists" guard.
# There was one, and it made the claim at the top of this file false: a cached
# fixture is not an outside opinion, it is whatever the generator said the last
# time somebody happened to delete the file. It cost a confusing failure on
# 2026-09-04 -- new conformance checks run against a vector the *previous*
# generator wrote, which reads as a code bug and is not one. It also meant this
# script and php-conformance.yml were testing different things, since CI has
# always regenerated unconditionally.
#
# The cost is what cargo spends deciding an already-built binary is current.
# On a cold tree it builds, which is the build a fresh checkout owes anyway.
echo "==> generating conformance vectors"
( cd "$ROOT/php-client/vectors-gen" && cargo run --release --locked ) > "$VECTORS"

echo "==> php conformance"
php "$ROOT/php-client/conformance/vectors.php" "$VECTORS"

# A second conformance run against a *committed* fixture, and the difference in
# provenance is the point. The vectors above are regenerated from the published
# crate on every run -- an outside opinion about what the right answers are.
# This one is recorded by pay-on-chain/tests against the *local* program, which
# is the only thing that can say whether php-client's preflight arithmetic
# agrees with the program you are about to deploy. It moves when bin/test-rust
# rewrites it, so a moved verdict arrives as a reviewable diff.
#
# No Rust runs here: the fixture is committed precisely so this check needs
# neither a toolchain nor a built program. If it is missing, that is a broken
# checkout and the script says so rather than skipping.
echo "==> php preflight against the program"
php "$ROOT/php-client/conformance/preflight.php"

echo "done."
