#!/usr/bin/env bash
#
# Run the Rust test suites.
#
#   bin/test-rust                     everything
#   bin/test-rust settles_only        pass a filter through to cargo test
#
# The LiteSVM harness loads target/deploy/pay_on_chain.so, so the program has
# to be built first. This builds it when it is missing; after changing the
# program, run bin/build-rust --program yourself to pick the change up.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SO="$ROOT/pay-on-chain/target/deploy/pay_on_chain.so"

if [ ! -f "$SO" ]; then
  echo "==> $SO missing; building the program first"
  "$ROOT/bin/build-rust" --program
fi

# --locked everywhere: run against the committed Cargo.lock or fail. A test
# run that silently re-resolved would not be testing the versions we ship.
#
# Program behaviour plus the client/program parity checks, which live here
# because they need both sides in one build.
echo "==> cargo test (pay-on-chain)"
( cd "$ROOT/pay-on-chain" && cargo test --locked "$@" )

# --no-default-features drops the `wasm` feature so the UI-agnostic core is
# tested natively, without wasm-bindgen.
echo "==> cargo test (wasm-client core)"
( cd "$ROOT/wasm-client" && cargo test --locked --no-default-features "$@" )

echo "done."
